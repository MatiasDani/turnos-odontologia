# Valores ficticios. Copiar a .env (ignorado por git) si hace falta.
TZ_CONSULTORIO=America/Argentina/Buenos_Aires

# Recordatorios por e-mail (C-12, DD-21)
# Base de los enlaces de confirmación y gestión que van en el e-mail.
BASE_URL_PUBLICA=http://localhost:3000
# Anticipación del recordatorio en horas (entero entre 1 y 720).
RECORDATORIO_HORAS_ANTES=24

# SMTP. Para desarrollo y demo: Ethereal (https://ethereal.email), que no entrega a casillas reales.
# Las credenciales se generan en ethereal.email y van SOLO en tu .env local, nunca acá.
# El remitente de los e-mails es SMTP_USER.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Servidor HTTP público (C-14, DD-29). `npm run build && npm start`
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
# BASE_URL_PUBLICA (ver arriba) se usa para los enlaces de los e-mails; si falta, el servidor deriva http://HOST:PORT.

# Sesión del personal (C-09, DD-37). Obligatoria, 32 caracteres o más. Generá la tuya solo en tu .env.
JWT_SECRET=cambiar-en-local-por-32-caracteres-o-mas
# Administrador que se crea al arrancar si no hay usuarios (C-09, DD-35). Ambas o ninguna.
ADMIN_EMAIL_INICIAL=admin@demo.test
ADMIN_CLAVE_INICIAL=cambiar-en-local
